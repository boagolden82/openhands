{
  "version": "2.0.0",
  "name": "RDE-Onto 研发效能本体",
  "description": "面向 MR/RR 研发交付流程与 AI 辅助研发的过程度量本体。指标口径（分子、分母、目标、权重、归一化）全部定义在本文件中，修改口径只需改 JSON。",
  "namespaces": {
    "core": "上层本体：实体、参与者、事件、产出物",
    "dev": "研发领域本体：组织、项目、MR/RR、阶段、工作产物",
    "metric": "指标本体：原子、派生、配对、复合"
  },
  "dimensions": [
    {
      "id": "center",
      "name": "研发中心",
      "description": "组织顶层，用于年度总体口径"
    },
    {
      "id": "projectGroup",
      "name": "项目组",
      "description": "研发项目组，指标下钻的主要维度"
    },
    {
      "id": "project",
      "name": "研发项目",
      "description": "项目组下的具体研发项目"
    },
    {
      "id": "time",
      "name": "时间",
      "description": "按周/月/年粒度的时间桶"
    },
    {
      "id": "phase",
      "name": "阶段",
      "description": "分析/开发/测试/验收"
    },
    {
      "id": "priority",
      "name": "优先级",
      "description": "MR 优先级"
    },
    {
      "id": "source",
      "name": "需求来源",
      "description": "MR 提出渠道"
    }
  ],
  "classes": [
    {
      "id": "core:Entity",
      "label": "实体",
      "parent": null,
      "namespace": "core",
      "description": "本体中一切可标识对象的根类"
    },
    {
      "id": "core:Actor",
      "label": "参与者",
      "parent": "core:Entity",
      "namespace": "core",
      "description": "能够承担职责或产生行为的实体"
    },
    {
      "id": "core:Event",
      "label": "事件",
      "parent": "core:Entity",
      "namespace": "core",
      "description": "在时间轴上发生的一次事实"
    },
    {
      "id": "core:Artifact",
      "label": "产出物",
      "parent": "core:Entity",
      "namespace": "core",
      "description": "被创造、流转、交付的对象"
    },
    {
      "id": "dev:Organization",
      "label": "组织",
      "parent": "core:Actor",
      "namespace": "dev",
      "description": "承担研发职责的组织单元"
    },
    {
      "id": "dev:Center",
      "label": "研发中心",
      "parent": "dev:Organization",
      "namespace": "dev",
      "description": "组织顶层，聚合全部项目组"
    },
    {
      "id": "dev:ProjectGroup",
      "label": "项目组",
      "parent": "dev:Organization",
      "namespace": "dev",
      "description": "按业务域划分的研发项目组"
    },
    {
      "id": "dev:Project",
      "label": "研发项目",
      "parent": "core:Artifact",
      "namespace": "dev",
      "description": "项目组内的具体研发项目"
    },
    {
      "id": "dev:Person",
      "label": "人员",
      "parent": "core:Actor",
      "namespace": "dev",
      "description": "投入研发的人力"
    },
    {
      "id": "dev:Employee",
      "label": "中心人力",
      "parent": "dev:Person",
      "namespace": "dev",
      "description": "中心自有编制人力"
    },
    {
      "id": "dev:Outsourced",
      "label": "外包人力",
      "parent": "dev:Person",
      "namespace": "dev",
      "description": "外包投入人力，按折算系数计入"
    },
    {
      "id": "dev:MR",
      "label": "MR",
      "parent": "core:Artifact",
      "namespace": "dev",
      "description": "需求最小交付单元，经历分析/开发/测试/验收四阶段"
    },
    {
      "id": "dev:RR",
      "label": "RR",
      "parent": "core:Artifact",
      "namespace": "dev",
      "description": "按研发项目归集的发布需求，用于按期达成考核"
    },
    {
      "id": "dev:WorkProduct",
      "label": "工作产物",
      "parent": "core:Artifact",
      "namespace": "dev",
      "description": "研发过程中产生的可计数产物"
    },
    {
      "id": "dev:AnalysisDoc",
      "label": "需求分析",
      "parent": "dev:WorkProduct",
      "namespace": "dev",
      "description": "需求分析产物"
    },
    {
      "id": "dev:SolutionDoc",
      "label": "需求方案",
      "parent": "dev:WorkProduct",
      "namespace": "dev",
      "description": "需求方案产物"
    },
    {
      "id": "dev:CodeChange",
      "label": "代码变更",
      "parent": "dev:WorkProduct",
      "namespace": "dev",
      "description": "代码行级变更"
    },
    {
      "id": "dev:TestCase",
      "label": "测试用例",
      "parent": "dev:WorkProduct",
      "namespace": "dev",
      "description": "测试用例"
    },
    {
      "id": "dev:TestScript",
      "label": "测试脚本",
      "parent": "dev:WorkProduct",
      "namespace": "dev",
      "description": "自动化测试脚本"
    },
    {
      "id": "dev:Phase",
      "label": "阶段",
      "parent": "core:Event",
      "namespace": "dev",
      "description": "MR 生命周期中的一个阶段完成事件"
    },
    {
      "id": "dev:AnalysisPhase",
      "label": "分析阶段",
      "parent": "dev:Phase",
      "namespace": "dev",
      "description": "需求分析阶段"
    },
    {
      "id": "dev:DevPhase",
      "label": "开发阶段",
      "parent": "dev:Phase",
      "namespace": "dev",
      "description": "编码实现阶段"
    },
    {
      "id": "dev:TestPhase",
      "label": "测试阶段",
      "parent": "dev:Phase",
      "namespace": "dev",
      "description": "测试验证阶段"
    },
    {
      "id": "dev:AcceptPhase",
      "label": "验收阶段",
      "parent": "dev:Phase",
      "namespace": "dev",
      "description": "验收交付阶段"
    },
    {
      "id": "metric:Metric",
      "label": "指标",
      "parent": "core:Entity",
      "namespace": "metric",
      "description": "可计算的度量定义"
    },
    {
      "id": "metric:AtomicMetric",
      "label": "原子指标",
      "parent": "metric:Metric",
      "namespace": "metric",
      "description": "直接由单类事实聚合得到"
    },
    {
      "id": "metric:DerivedMetric",
      "label": "派生指标",
      "parent": "metric:Metric",
      "namespace": "metric",
      "description": "由其他指标经表达式计算得到"
    },
    {
      "id": "metric:Indicator",
      "label": "北极星指标",
      "parent": "metric:DerivedMetric",
      "namespace": "metric",
      "description": "对外汇报的核心指标"
    }
  ],
  "relations": [
    {
      "id": "belongsTo",
      "label": "隶属于",
      "domain": "core:Entity",
      "range": "core:Entity",
      "transitive": true,
      "inverse": "hasMember"
    },
    {
      "id": "hasMember",
      "label": "包含",
      "domain": "core:Entity",
      "range": "core:Entity",
      "transitive": true,
      "inverse": "belongsTo"
    },
    {
      "id": "staffedBy",
      "label": "配置人力",
      "domain": "dev:ProjectGroup",
      "range": "dev:Person",
      "transitive": false,
      "inverse": "staffs"
    },
    {
      "id": "staffs",
      "label": "服务于",
      "domain": "dev:Person",
      "range": "dev:ProjectGroup",
      "transitive": false,
      "inverse": "staffedBy"
    },
    {
      "id": "phasedBy",
      "label": "经历阶段",
      "domain": "dev:MR",
      "range": "dev:Phase",
      "transitive": false,
      "inverse": "phaseOf"
    },
    {
      "id": "phaseOf",
      "label": "属于MR",
      "domain": "dev:Phase",
      "range": "dev:MR",
      "transitive": false,
      "inverse": "phasedBy"
    },
    {
      "id": "produces",
      "label": "产出",
      "domain": "dev:MR",
      "range": "dev:WorkProduct",
      "transitive": false,
      "inverse": "producedBy"
    },
    {
      "id": "producedBy",
      "label": "由...产出",
      "domain": "dev:WorkProduct",
      "range": "dev:MR",
      "transitive": false,
      "inverse": "produces"
    },
    {
      "id": "covers",
      "label": "覆盖MR",
      "domain": "dev:RR",
      "range": "dev:MR",
      "transitive": false,
      "inverse": "coveredBy"
    },
    {
      "id": "coveredBy",
      "label": "被RR覆盖",
      "domain": "dev:MR",
      "range": "dev:RR",
      "transitive": false,
      "inverse": "covers"
    },
    {
      "id": "deliversTo",
      "label": "交付至",
      "domain": "dev:MR",
      "range": "dev:Project",
      "transitive": false,
      "inverse": "deliveredFrom"
    },
    {
      "id": "deliveredFrom",
      "label": "交付来源",
      "domain": "dev:Project",
      "range": "dev:MR",
      "transitive": false,
      "inverse": "deliversTo"
    },
    {
      "id": "dependsOn",
      "label": "依赖",
      "domain": "metric:Metric",
      "range": "metric:Metric",
      "transitive": true,
      "inverse": "dependedBy"
    },
    {
      "id": "dependedBy",
      "label": "被依赖",
      "domain": "metric:Metric",
      "range": "metric:Metric",
      "transitive": true,
      "inverse": "dependsOn"
    }
  ],
  "factTypes": [
    {
      "id": "mr.created",
      "label": "MR提出",
      "subject": "dev:MR",
      "timeField": "created_at",
      "measures": [],
      "fields": [
        "project",
        "priority",
        "source"
      ],
      "phase": null,
      "description": "MR 进入研发流程的起点，用于计算分析周期与渗透率分母"
    },
    {
      "id": "mr.analysis.done",
      "label": "分析完成",
      "subject": "dev:MR",
      "timeField": "occurred_at",
      "measures": [
        "ai_analysis",
        "total_analysis",
        "ai_solution",
        "total_solution"
      ],
      "fields": [],
      "phase": "分析",
      "description": "需求分析与方案产出；ai_*/total_* 用于计算生成率"
    },
    {
      "id": "mr.dev.done",
      "label": "开发完成",
      "subject": "dev:MR",
      "timeField": "occurred_at",
      "measures": [
        "ai_lines",
        "total_lines"
      ],
      "fields": [],
      "phase": "开发",
      "description": "编码实现完成（MR 实现口径）；ai_lines/total_lines 用于代码生成率"
    },
    {
      "id": "mr.test.done",
      "label": "测试完成",
      "subject": "dev:MR",
      "timeField": "occurred_at",
      "measures": [
        "ai_cases",
        "total_cases",
        "ai_scripts",
        "total_scripts"
      ],
      "fields": [],
      "phase": "测试",
      "description": "测试验证完成；用例与脚本的 ai/total 用于 AI 生成率"
    },
    {
      "id": "mr.accepted",
      "label": "验收完成",
      "subject": "dev:MR",
      "timeField": "occurred_at",
      "measures": [],
      "fields": [],
      "phase": "验收",
      "description": "业务验收通过，验收周期终点"
    },
    {
      "id": "mr.delivered",
      "label": "MR交付",
      "subject": "dev:MR",
      "timeField": "occurred_at",
      "measures": [],
      "fields": [
        "project"
      ],
      "phase": null,
      "description": "MR 对外交付，交付人均数的分子"
    },
    {
      "id": "mr.ai.touched",
      "label": "MR使用AI",
      "subject": "dev:MR",
      "timeField": "occurred_at",
      "measures": [],
      "fields": [
        "artifacts"
      ],
      "phase": null,
      "description": "该 MR 在任一环节使用了 AI 辅助，用于计算 MR 渗透率"
    },
    {
      "id": "rr.planned",
      "label": "RR计划",
      "subject": "dev:RR",
      "timeField": "occurred_at",
      "measures": [
        "planned_count"
      ],
      "fields": [
        "project"
      ],
      "phase": null,
      "description": "RR 计划条目数，按期达成率的分母"
    },
    {
      "id": "rr.delivered",
      "label": "RR交付",
      "subject": "dev:RR",
      "timeField": "occurred_at",
      "measures": [
        "delivered_count",
        "on_time_count",
        "planned_count"
      ],
      "fields": [
        "project"
      ],
      "phase": null,
      "description": "RR 实际交付与按期数；planned_count 同步携带，确保达成率分子分母对齐同一批 RR"
    },
    {
      "id": "headcount.snapshot",
      "label": "人力快照",
      "subject": "dev:ProjectGroup",
      "timeField": "occurred_at",
      "measures": [
        "center_headcount",
        "outsourced_headcount",
        "outsourced_factor"
      ],
      "fields": [],
      "phase": null,
      "description": "项目组人力构成，人均类指标的分母；外包按折算系数计入"
    }
  ],
  "metrics": [
    {
      "id": "mr_created_count",
      "label": "MR提出数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.created",
      "agg": "count",
      "hidden": true,
      "description": "窗口内新提出的 MR 数。作为分析、开发等阶段指标的分母基准。"
    },
    {
      "id": "mr_analysis_done_count",
      "label": "MR分析完成数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.analysis.done",
      "agg": "count",
      "hidden": true,
      "description": "完成需求分析的 MR 数，是分析周期与人均分析吞吐率的分子。"
    },
    {
      "id": "mr_dev_done_count",
      "label": "MR开发完成数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.dev.done",
      "agg": "count",
      "hidden": true,
      "description": "完成编码开发的 MR 数，是开发周期与人均开发吞吐率的分子。"
    },
    {
      "id": "mr_test_done_count",
      "label": "MR测试完成数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.test.done",
      "agg": "count",
      "hidden": true,
      "description": "完成测试的 MR 数，是测试吞吐率的分子。"
    },
    {
      "id": "mr_accepted_count",
      "label": "MR验收完成数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.accepted",
      "agg": "count",
      "hidden": true,
      "description": "通过验收的 MR 数，是验收周期与交付数的基础。"
    },
    {
      "id": "mr_delivered_count",
      "label": "MR交付数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.delivered",
      "agg": "count",
      "hidden": true,
      "description": "实际交付上线的 MR 数，是人均交付数的分子。"
    },
    {
      "id": "mr_ai_touched_count",
      "label": "使用AI的MR数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.ai.touched",
      "agg": "count",
      "hidden": true,
      "description": "研发过程中至少有一个环节使用 AI 辅助的 MR 数，是渗透率的分子。"
    },
    {
      "id": "rr_planned_count",
      "label": "RR计划数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "rr.planned",
      "agg": "sum",
      "measure": "planned_count",
      "hidden": true,
      "description": "按研发项目、按月计划的 RR 条目数。"
    },
    {
      "id": "rr_on_time_count",
      "label": "RR按期交付数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "rr.delivered",
      "agg": "sum",
      "measure": "on_time_count",
      "hidden": true,
      "description": "在计划日期前完成交付的 RR 数，是 RR 按期达成率的分子。"
    },
    {
      "id": "rr_delivered_planned",
      "label": "已交付RR计划数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "rr.delivered",
      "agg": "sum",
      "measure": "planned_count",
      "hidden": true,
      "description": "已交付 RR 对应的计划数。与按期数取同一批事实，保证达成率分子分母对齐。"
    },
    {
      "id": "rr_delivered_count",
      "label": "RR实际交付数",
      "unit": "个",
      "type": "atomic",
      "layer": "base",
      "fact": "rr.delivered",
      "agg": "sum",
      "measure": "delivered_count",
      "hidden": true,
      "description": "实际交付的 RR 条目数。"
    },
    {
      "id": "headcount_center",
      "label": "中心人力",
      "unit": "人",
      "type": "atomic",
      "layer": "base",
      "fact": "headcount.snapshot",
      "agg": "snapshot",
      "measure": "center_headcount",
      "carry": 6,
      "hidden": true,
      "description": "中心在册研发人力，按月快照。取窗口内各主体最新值后求和。"
    },
    {
      "id": "headcount_outsourced",
      "label": "外包人力",
      "unit": "人",
      "type": "atomic",
      "layer": "base",
      "fact": "headcount.snapshot",
      "agg": "snapshot",
      "measure": "outsourced_headcount",
      "carry": 6,
      "hidden": true,
      "description": "外包研发人力，按月快照，与中心人力同期统计。"
    },
    {
      "id": "outsourced_factor",
      "label": "外包折算系数",
      "unit": "系数",
      "type": "atomic",
      "layer": "base",
      "fact": "headcount.snapshot",
      "agg": "snapshot",
      "measure": "outsourced_factor",
      "carry": 6,
      "hidden": true,
      "snapshotCombine": "avg",
      "description": "外包人力折算系数，比率型度量，跨主体取平均而非求和。"
    },
    {
      "id": "ai_analysis_count",
      "label": "AI需求分析数",
      "unit": "份",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.analysis.done",
      "agg": "sum",
      "measure": "ai_analysis",
      "hidden": true,
      "description": "AI 辅助产出的需求分析文档数。"
    },
    {
      "id": "total_analysis_count",
      "label": "需求分析总数",
      "unit": "份",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.analysis.done",
      "agg": "sum",
      "measure": "total_analysis",
      "hidden": true,
      "description": "需求分析文档总数，含人工撰写。"
    },
    {
      "id": "ai_solution_count",
      "label": "AI需求方案数",
      "unit": "份",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.analysis.done",
      "agg": "sum",
      "measure": "ai_solution",
      "hidden": true,
      "description": "AI 辅助产出的需求方案数。"
    },
    {
      "id": "total_solution_count",
      "label": "需求方案总数",
      "unit": "份",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.analysis.done",
      "agg": "sum",
      "measure": "total_solution",
      "hidden": true,
      "description": "需求方案总数，含人工撰写。"
    },
    {
      "id": "ai_lines",
      "label": "AI生成代码行",
      "unit": "行",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.dev.done",
      "agg": "sum",
      "measure": "ai_lines",
      "hidden": true,
      "description": "AI 生成的代码行数。"
    },
    {
      "id": "total_lines",
      "label": "代码变更总行",
      "unit": "行",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.dev.done",
      "agg": "sum",
      "measure": "total_lines",
      "hidden": true,
      "description": "代码变更总行数，含人工编写。"
    },
    {
      "id": "ai_cases",
      "label": "AI生成用例数",
      "unit": "条",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.test.done",
      "agg": "sum",
      "measure": "ai_cases",
      "hidden": true,
      "description": "AI 生成的测试用例数。"
    },
    {
      "id": "total_cases",
      "label": "用例总数",
      "unit": "条",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.test.done",
      "agg": "sum",
      "measure": "total_cases",
      "hidden": true,
      "description": "测试用例总数，含人工编写。"
    },
    {
      "id": "ai_scripts",
      "label": "AI生成脚本数",
      "unit": "条",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.test.done",
      "agg": "sum",
      "measure": "ai_scripts",
      "hidden": true,
      "description": "AI 生成的自动化脚本数。"
    },
    {
      "id": "total_scripts",
      "label": "脚本总数",
      "unit": "条",
      "type": "atomic",
      "layer": "base",
      "fact": "mr.test.done",
      "agg": "sum",
      "measure": "total_scripts",
      "hidden": true,
      "description": "自动化脚本总数，含人工编写。"
    },
    {
      "id": "mr_impl_cycle",
      "code": "2.0.1",
      "label": "MR实现周期",
      "unit": "h",
      "type": "pair",
      "layer": "detail",
      "startFact": "mr.created",
      "endFact": "mr.dev.done",
      "agg": "median",
      "direction": "down",
      "target": 120,
      "precision": 1,
      "description": "MR 从提出到开发完成的中位时长；口径上等于分析周期与开发周期之和。",
      "formula": "median(mr.dev.done - mr.created)",
      "owner": "研发效能平台",
      "primary": true
    },
    {
      "id": "mr_analysis_cycle",
      "code": "2.8",
      "label": "MR分析周期",
      "unit": "h",
      "type": "pair",
      "layer": "detail",
      "startFact": "mr.created",
      "endFact": "mr.analysis.done",
      "agg": "median",
      "direction": "down",
      "target": 48,
      "precision": 1,
      "description": "MR 从提出到需求分析完成的中位时长。",
      "formula": "median(mr.analysis.done - mr.created)",
      "owner": "需求分析组"
    },
    {
      "id": "mr_dev_cycle",
      "code": "2.10",
      "label": "MR开发周期",
      "unit": "h",
      "type": "pair",
      "layer": "detail",
      "startFact": "mr.analysis.done",
      "endFact": "mr.dev.done",
      "agg": "median",
      "direction": "down",
      "target": 72,
      "precision": 1,
      "description": "MR 从分析完成到编码实现完成的中位时长。",
      "formula": "median(mr.dev.done - mr.analysis.done)",
      "owner": "开发组"
    },
    {
      "id": "mr_accept_cycle",
      "code": "2.12",
      "label": "MR验收周期",
      "unit": "h",
      "type": "pair",
      "layer": "detail",
      "startFact": "mr.dev.done",
      "endFact": "mr.accepted",
      "agg": "median",
      "direction": "down",
      "target": 24,
      "precision": 1,
      "description": "MR 从开发完成到验收通过的中位时长。",
      "formula": "median(mr.accepted - mr.dev.done)",
      "owner": "质量保障"
    },
    {
      "id": "converted_headcount",
      "code": null,
      "label": "折算总人力",
      "unit": "人",
      "type": "derived",
      "layer": "detail",
      "expr": "headcount_center + headcount_outsourced * outsourced_factor",
      "deps": [
        "headcount_center",
        "headcount_outsourced",
        "outsourced_factor"
      ],
      "target": null,
      "direction": "up",
      "precision": 2,
      "description": "中心人力 + 外包人力 × 折算系数，用于 2.4 的折算人均口径。",
      "formula": "center + outsourced * factor",
      "hidden": true
    },
    {
      "id": "rr_on_time_rate",
      "code": "2.0.2",
      "label": "RR按期达成率",
      "unit": "%",
      "type": "derived",
      "layer": "detail",
      "expr": "rr_on_time_count / rr_delivered_planned * 100",
      "deps": [
        "rr_on_time_count",
        "rr_delivered_planned"
      ],
      "target": 90,
      "direction": "up",
      "precision": 2,
      "description": "已交付 RR 中按期交付的比例。分子分母取同一批 RR 事实，避免窗口边界造成口径错位。",
      "formula": "on_time / planned * 100（同一批已交付 RR）",
      "owner": "研发管理部",
      "primary": true,
      "indicator": false
    },
    {
      "id": "mr_delivery_per_capita",
      "code": "2.1",
      "label": "MR研发人均交付数",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_delivered_count / headcount_center / max(months, 1)",
      "deps": [
        "mr_delivered_count",
        "headcount_center"
      ],
      "target": 1.2,
      "direction": "up",
      "precision": 2,
      "description": "窗口内 MR 交付数 ÷ 中心人力 ÷ 月数，衡量人均对外交付产出。",
      "formula": "delivered / headcount / months",
      "owner": "研发管理部",
      "primary": true
    },
    {
      "id": "mr_impl_per_capita",
      "code": "2.2",
      "label": "MR研发人均实现数",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_dev_done_count / headcount_center / max(months, 1)",
      "deps": [
        "mr_dev_done_count",
        "headcount_center"
      ],
      "target": 1.6,
      "direction": "up",
      "precision": 2,
      "description": "窗口内 MR 开发完成数 ÷ 中心人力 ÷ 月数，衡量人均实现产出。",
      "formula": "dev_done / headcount / months",
      "owner": "研发管理部"
    },
    {
      "id": "mr_impl_per_capita_live",
      "code": "2.3",
      "label": "MR研发人均实现数（实时）",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_dev_done_count / headcount_center / max(months, 1)",
      "deps": [
        "mr_dev_done_count",
        "headcount_center"
      ],
      "target": 1.6,
      "direction": "up",
      "precision": 2,
      "description": "与 2.2 同口径，按当前窗口实时计算；配合同比视图对比 2025 全年与 2026 年 1-10 月。",
      "formula": "dev_done / headcount / months",
      "owner": "研发管理部",
      "primary": true,
      "realtime": true
    },
    {
      "id": "mr_impl_per_capita_converted",
      "code": "2.4",
      "label": "MR研发人均实现数（中心+外包折算）",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_dev_done_count / converted_headcount / max(months, 1)",
      "deps": [
        "mr_dev_done_count",
        "converted_headcount"
      ],
      "target": 1.4,
      "direction": "up",
      "precision": 2,
      "description": "分母改用中心人力与外包折算人力之和，口径更贴近实际投入；可按项目组下钻核对人力口径。",
      "formula": "dev_done / (center + outsourced*factor) / months",
      "owner": "研发管理部"
    },
    {
      "id": "mr_analysis_throughput",
      "code": "2.7",
      "label": "MR人均分析吞吐率",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_analysis_done_count / headcount_center / max(months, 1)",
      "deps": [
        "mr_analysis_done_count",
        "headcount_center"
      ],
      "target": 1.8,
      "direction": "up",
      "precision": 2,
      "description": "人均每月完成需求分析的 MR 数，衡量分析环节产能。",
      "formula": "analysis_done / headcount / months",
      "owner": "需求分析组"
    },
    {
      "id": "mr_dev_throughput",
      "code": "2.9",
      "label": "MR人均开发吞吐率",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_dev_done_count / headcount_center / max(months, 1)",
      "deps": [
        "mr_dev_done_count",
        "headcount_center"
      ],
      "target": 1.6,
      "direction": "up",
      "precision": 2,
      "description": "人均每月完成开发的 MR 数，衡量开发环节产能。",
      "formula": "dev_done / headcount / months",
      "owner": "开发组"
    },
    {
      "id": "mr_test_throughput",
      "code": "2.11",
      "label": "MR人均测试吞吐率",
      "unit": "个/人月",
      "type": "derived",
      "layer": "detail",
      "expr": "mr_test_done_count / headcount_center / max(months, 1)",
      "deps": [
        "mr_test_done_count",
        "headcount_center"
      ],
      "target": 1.7,
      "direction": "up",
      "precision": 2,
      "description": "人均每月完成测试的 MR 数，衡量测试环节产能。",
      "formula": "test_done / headcount / months",
      "owner": "质量保障"
    },
    {
      "id": "analysis_gen_rate",
      "code": "3.1",
      "label": "需求分析生成率",
      "unit": "%",
      "type": "derived",
      "layer": "process",
      "expr": "ai_analysis_count / total_analysis_count * 100",
      "deps": [
        "ai_analysis_count",
        "total_analysis_count"
      ],
      "target": 60,
      "direction": "up",
      "precision": 2,
      "description": "AI 生成的需求分析份数占分析总份数比例。",
      "formula": "ai_analysis / total_analysis * 100",
      "owner": "工程效能"
    },
    {
      "id": "solution_gen_rate",
      "code": "3.2",
      "label": "需求方案生成率",
      "unit": "%",
      "type": "derived",
      "layer": "process",
      "expr": "ai_solution_count / total_solution_count * 100",
      "deps": [
        "ai_solution_count",
        "total_solution_count"
      ],
      "target": 55,
      "direction": "up",
      "precision": 2,
      "description": "AI 生成的需求方案份数占方案总份数比例。",
      "formula": "ai_solution / total_solution * 100",
      "owner": "工程效能"
    },
    {
      "id": "code_gen_rate",
      "code": "3.3",
      "label": "代码生成率",
      "unit": "%",
      "type": "derived",
      "layer": "process",
      "expr": "ai_lines / total_lines * 100",
      "deps": [
        "ai_lines",
        "total_lines"
      ],
      "target": 45,
      "direction": "up",
      "precision": 2,
      "description": "AI 生成代码行数占代码变更总行数比例，按行统计。",
      "formula": "ai_lines / total_lines * 100",
      "owner": "工程效能",
      "primary": true
    },
    {
      "id": "ai_testcase_gen_rate",
      "code": "3.4",
      "label": "AI测试用例生成率",
      "unit": "%",
      "type": "derived",
      "layer": "process",
      "expr": "ai_cases / total_cases * 100",
      "deps": [
        "ai_cases",
        "total_cases"
      ],
      "target": 50,
      "direction": "up",
      "precision": 2,
      "description": "AI 生成的测试用例数占用例总数比例。",
      "formula": "ai_cases / total_cases * 100",
      "owner": "质量保障"
    },
    {
      "id": "ai_script_gen_rate",
      "code": "3.5",
      "label": "AI脚本生成率",
      "unit": "%",
      "type": "derived",
      "layer": "process",
      "expr": "ai_scripts / total_scripts * 100",
      "deps": [
        "ai_scripts",
        "total_scripts"
      ],
      "target": 40,
      "direction": "up",
      "precision": 2,
      "description": "AI 生成的自动化测试脚本数占脚本总数比例。",
      "formula": "ai_scripts / total_scripts * 100",
      "owner": "质量保障"
    },
    {
      "id": "mr_ai_penetration",
      "code": "3.6",
      "label": "MR渗透率（累计）",
      "unit": "%",
      "type": "derived",
      "layer": "process",
      "expr": "mr_ai_touched_count / mr_created_count * 100",
      "deps": [
        "mr_ai_touched_count",
        "mr_created_count"
      ],
      "target": 70,
      "direction": "up",
      "precision": 2,
      "description": "窗口内使用过 AI 辅助的 MR 占全部 MR 比例；默认按 2026 年累计口径查看各项目组。",
      "formula": "ai_touched / created * 100",
      "owner": "工程效能",
      "primary": true
    },
    {
      "id": "rde_index",
      "code": null,
      "label": "研发提效指数",
      "unit": "分",
      "type": "composite",
      "layer": "composite",
      "direction": "up",
      "target": 85,
      "precision": 1,
      "indicator": true,
      "primary": true,
      "deps": [
        "rr_on_time_rate",
        "mr_impl_per_capita",
        "code_gen_rate",
        "mr_impl_cycle",
        "mr_ai_penetration"
      ],
      "scoring": {
        "components": [
          {
            "dep": "rr_on_time_rate",
            "weight": 0.25,
            "goal": 90,
            "scale": "higher_better"
          },
          {
            "dep": "mr_impl_per_capita",
            "weight": 0.2,
            "goal": 1.6,
            "scale": "higher_better"
          },
          {
            "dep": "code_gen_rate",
            "weight": 0.2,
            "goal": 45,
            "scale": "higher_better"
          },
          {
            "dep": "mr_impl_cycle",
            "weight": 0.2,
            "goal": 120,
            "scale": "lower_better"
          },
          {
            "dep": "mr_ai_penetration",
            "weight": 0.15,
            "goal": 70,
            "scale": "higher_better"
          }
        ]
      },
      "description": "由 RR 按期达成率、人均实现数、代码生成率、MR 实现周期与 MR 渗透率按本体权重归一化合成，权重与目标值均定义在本体中。",
      "formula": "Σ(weight × normalize(dep, goal)) / Σweight × 100",
      "owner": "研发管理部"
    }
  ]
}
