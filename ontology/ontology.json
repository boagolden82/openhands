      "description": "技术债故事点占全部需求故事点的比例，用于评估长期健康度投入是否充足。",
      "formula": "tech_debt_points / total_story_points × 100%",
      "owner": "架构组",
      "primary": true
    },
    {
      "id": "dev_eff_index",
      "label": "研发效能指数",
      "unit": "分",
      "type": "composite",
      "layer": "delivery",
      "deps": [
        "lead_time_hours",
        "deploy_frequency",
        "change_failure_rate",
        "mttr_minutes",
        "sprint_completion_rate",
        "cycle_time_hours"
      ],
      "scoring": {
        "components": [
          {
            "dep": "lead_time_hours",
            "weight": 0.2,
            "goal": 48,
            "scale": "lower_better"
          },
          {
            "dep": "deploy_frequency",
            "weight": 0.15,
            "goal": 10,
            "scale": "higher_better"
          },
          {
            "dep": "change_failure_rate",
            "weight": 0.2,
            "goal": 15,
            "scale": "lower_better"
          },
          {
            "dep": "mttr_minutes",
            "weight": 0.1,
            "goal": 60,
            "scale": "lower_better"
          },
          {
            "dep": "sprint_completion_rate",
            "weight": 0.15,
            "goal": 90,
            "scale": "higher_better"
          },
          {
            "dep": "cycle_time_hours",
            "weight": 0.2,
            "goal": 72,
            "scale": "lower_better"
          }
        ]
      },
      "direction": "up",
      "target": 75,
      "precision": 1,
      "description": "DORA 四指标 + 迭代达成率的加权归一化综合得分。每个分量按『达标即满分』归一化（越低越好者取 goal/value），权重可在本体文件中调整。",
      "formula": "Σ wᵢ · norm(metricᵢ, goalᵢ) × 100",
      "owner": "研发管理部",
      "indicator": true
    },
    {
      "id": "cycle_time_hours",
      "label": "需求交付周期",
      "unit": "h",
      "type": "pair",
      "layer": "flow",
      "startFact": "workitem.created",
      "endFact": "workitem.closed",
      "joinOn": "subject",
      "measure": "cycle_hours",
      "agg": "median",
      "direction": "down",
      "target": 72,
      "precision": 1,
      "description": "已关闭工作项从创建到关闭的中位耗时。该指标需要把两类事实按同一主体 join，由本体关系驱动，无法从单一事实表直接聚合。",
      "formula": "median(workitem.closed.occurred_at - workitem.created.occurred_at)",
      "owner": "敏捷教练",
      "primary": true
    },
    {
      "id": "delivered_items",
      "label": "交付工作项数",
      "unit": "项/周",
      "type": "atomic",
      "layer": "delivery",
      "fact": "workitem.closed",
      "agg": "count",
      "measure": null,
      "normalize": {
        "per": "week"
      },
      "direction": "up",
      "target": 25,
      "precision": 1,
      "description": "每周关闭的工作项数量，反映需求消化速度。",
      "formula": "count(workitem.closed) / window_weeks",
      "owner": "研发管理部",
      "primary": true
    }
  ]
